# parcel_gas_usage_map.py
#
# 1. joins gas meters to parcels (each meter gets its parcel PIN) - both city and county parcels
# 2. aggregates JUL_26 and JAN_26 consumption + meter count PER PARCEL (intermediate stats table)
# 3. joins to exported features ParcelArea_GasUsage, new parcel FC with usage data
# 4. flags parcels with more than one meter (ex apartment buildings) usage becomes sum

import arcpy
import os
import sys

GAS_METERS_GDB = r"\\metanoia\GeoData\DepartmentOfUtilities\Simpson_A\Projects\ASimpson_Editing\ASimpson_Editing\ASimpson_Editing.gdb"
GAS_METERS_FC = os.path.join(GAS_METERS_GDB, "GasMeters_082526_WithConsumption")

# consumption fields on the meters (long/numeric). one total per period.
CONSUMPTION_FIELDS = ["JUL_26", "JAN_26"]

PARCEL_FC = os.path.join(GAS_METERS_GDB, "ParcelArea_GasUsage")
PARCEL_ID_FIELD = "PIN"

# output gdb
OUTPUT_GDB = GAS_METERS_GDB
METERS_WITH_PIN = os.path.join(OUTPUT_GDB, "Meters_With_PIN")
PARCEL_SUMMARY_TABLE = os.path.join(OUTPUT_GDB, "Parcel_Meter_Summary")  
OUTPUT_PARCELS_FC = os.path.join(OUTPUT_GDB, "Parcels_GasUsage")  

MULTI_METER_THRESHOLD = 2  #flagging multi meter

# symbology....disabled
APPLY_SYMBOLOGY = False
APRX_PATH = r"C:\xxxxxxxxxx.aprx"
MAP_NAME = "Map"

#   TOTAL_JUL_26 -> Parcels_GasUsage_TOTAL_JUL_26 (high season)
#   TOTAL_JAN_26 -> Parcels_GasUsage_TOTAL_JAN_26 (low season)
SYMBOLOGY_FIELDS = ["TOTAL_JUL_26", "TOTAL_JAN_26"]

# check for failed join
def check_field_exists(fc, field_name, label):
    names = {f.name for f in arcpy.ListFields(fc)}
    if field_name not in names:
        sys.exit(
            "ERROR: Field '{0}' not found on {1} ({2}).\n"
            "Available fields: {3}".format(
                field_name, label, fc, ", ".join(sorted(names))
            )
        )


def step1_join_meters_to_parcels():
    # add PIN to meter
    print("Step 1: Spatially joining meters to parcels...")

    fms = arcpy.FieldMappings()
    fms.addTable(GAS_METERS_FC)
    fms.addTable(PARCEL_FC)

    # Keep only PIN from the parcel
    join_field_names = {f.name for f in arcpy.ListFields(PARCEL_FC)}
    for fname in list(join_field_names):
        if fname != PARCEL_ID_FIELD:
            idx = fms.findFieldMapIndex(fname)
            if idx >= 0:
                fms.removeFieldMap(idx)

    arcpy.analysis.SpatialJoin(
        target_features=GAS_METERS_FC,
        join_features=PARCEL_FC,
        out_feature_class=METERS_WITH_PIN,
        join_operation="JOIN_ONE_TO_ONE",
        join_type="KEEP_ALL",
        field_mapping=fms,
        match_option="INTERSECT",
    )
    print("  -> " + METERS_WITH_PIN)


def step2_summarize_by_parcel():
    # Sum JUL_26 and JAN_26, and count meters, per parcel by PIN
    print("Step 2: Summarizing consumption + meter count per parcel...")

    stats_fields = [[f, "SUM"] for f in CONSUMPTION_FIELDS]
    # OBJECTID to get meter-per-parcel count regardless of null consumption
    stats_fields.append(["OBJECTID", "COUNT"])

    arcpy.analysis.Statistics(
        in_table=METERS_WITH_PIN,
        out_table=PARCEL_SUMMARY_TABLE,
        statistics_fields=stats_fields,
        case_field=PARCEL_ID_FIELD,
    )
    print("  -> " + PARCEL_SUMMARY_TABLE + " (intermediate table only)")


def step3_join_summary_to_parcels():
    # local export of ParcelArea_GasUsage locally and join stats table to get FC with usage data
    print("Step 3: Joining summary stats onto parcel polygons...")

    arcpy.management.CopyFeatures(PARCEL_FC, OUTPUT_PARCELS_FC)

    sum_fields = ["SUM_" + f for f in CONSUMPTION_FIELDS]
    count_field = "COUNT_OBJECTID"

    arcpy.management.JoinField(
        in_data=OUTPUT_PARCELS_FC,
        in_field=PARCEL_ID_FIELD,
        join_table=PARCEL_SUMMARY_TABLE,
        join_field=PARCEL_ID_FIELD,
        fields=sum_fields + [count_field],
    )

    # rename fields and multi-meter flag
    total_field_names = ["TOTAL_" + f for f in CONSUMPTION_FIELDS]
    for tf in total_field_names:
        arcpy.management.AddField(OUTPUT_PARCELS_FC, tf, "DOUBLE")
    arcpy.management.AddField(OUTPUT_PARCELS_FC, "METER_COUNT", "LONG")
    arcpy.management.AddField(OUTPUT_PARCELS_FC, "MULTI_METER", "TEXT", field_length=3)

    cursor_fields = sum_fields + [count_field] + total_field_names + ["METER_COUNT", "MULTI_METER"]
    with arcpy.da.UpdateCursor(OUTPUT_PARCELS_FC, cursor_fields) as cursor:
        n_sums = len(sum_fields)
        for row in cursor:
            raw_sums = row[0:n_sums]
            meter_count = row[n_sums]
            for i in range(n_sums):
                row[n_sums + 1 + i] = raw_sums[i] if raw_sums[i] is not None else 0
            row[n_sums + 1 + n_sums] = meter_count if meter_count is not None else 0
            row[n_sums + 1 + n_sums + 1] = "YES" if (meter_count or 0) >= MULTI_METER_THRESHOLD else "NO"
            cursor.updateRow(row)

    # drop raw stats fields
    arcpy.management.DeleteField(OUTPUT_PARCELS_FC, sum_fields + [count_field])

    print("  -> " + OUTPUT_PARCELS_FC)
    print("     Fields added: " + ", ".join(total_field_names) + ", METER_COUNT, MULTI_METER")
    print("     ZONE and all other native ParcelArea_GasUsage fields carried through automatically.")
    print("     *** This feature class is the actual parcel layer w/ usage - add THIS to your map. ***")


