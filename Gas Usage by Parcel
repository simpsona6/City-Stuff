def main():
    arcpy.env.overwriteOutput = True

    if not arcpy.Exists(GAS_METERS_FC):
        sys.exit("ERROR: Gas meters FC not found: " + GAS_METERS_FC)
    if not arcpy.Exists(PARCEL_FC):
        sys.exit("ERROR: Parcel FC not found: " + PARCEL_FC)

    # Validate the ID field exists on the parcel source BEFORE running
    # anything - this is the most likely reason step 3 would have silently
    # failed and left you with only the Parcel_Meter_Summary table.
    # (Note: PIN does NOT exist on the gas meters FC yet - it only shows up
    # there after step 1's spatial join pulls it in from the parcel layer,
    # so we don't check for it there.)
    check_field_exists(PARCEL_FC, PARCEL_ID_FIELD, "parcel FC (ParcelArea_GasUsage)")

    step1_join_meters_to_parcels()
    step2_summarize_by_parcel()
    step3_join_summary_to_parcels()

    if APPLY_SYMBOLOGY:
        step4_apply_symbology()
    else:
        print("")
        print("Symbology step skipped (APPLY_SYMBOLOGY=False).")
        print("Add Parcels_GasUsage to your map twice, symbolize one copy by")
        print("TOTAL_JUL_26 and the other by TOTAL_JAN_26 (Graduated Colors,")
        print("Blues color scheme), or set APPLY_SYMBOLOGY=True above.")

    print("")
    print("Done. Final output feature class: " + OUTPUT_PARCELS_FC)


main()
