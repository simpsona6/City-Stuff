def normalize_basin_key(value):
    # Handles text ("10", "10-", " 10 "), ints (10), and doubles/floats
    # (10.0) -- GDB "Basin" fields are sometimes numeric, in which case
    # arcpy hands back a Python float and str(10.0) would otherwise come
    # out as "10.0" and silently fail to match TARGET_BASIN = "10".
    if value is None:
        return None
    if isinstance(value, float):
        if value.is_integer():
            return str(int(value))
        return str(value)
    if isinstance(value, int):
        return str(value)
    return str(value).strip().rstrip("-").strip()


def read_manholes(fc):
    manholes = {}
    fields = [MH_ID_FIELD, MH_RIM_FIELD, MH_DEPTH_FIELD, "SHAPE@XY"]
    with arcpy.da.SearchCursor(fc, fields) as cur:
        for mh_id, rim, depth, xy in cur:
            manholes[mh_id] = {"rim": rim, "depth": depth, "xy": xy}
    return manholes


def update_rim_fields(pipe_fc, manholes):
    # Copy RimElevation from manholes into the pipe's rim fields
    fields = [PIPE_UPSTREAM_MH_FIELD, PIPE_DOWNSTREAM_MH_FIELD,
              PIPE_UP_RIM_FIELD, PIPE_DOWN_RIM_FIELD]
    updated, missing = 0, 0
    with arcpy.da.UpdateCursor(pipe_fc, fields) as cur:
        for row in cur:
            up_mh, down_mh, up_rim, down_rim = row
            up = manholes.get(up_mh)
            down = manholes.get(down_mh)
            if up is None or down is None:
                missing += 1
                continue
            row[2] = up["rim"]
            row[3] = down["rim"]
            cur.updateRow(row)
            updated += 1
    arcpy.AddMessage(
        f"Rim fields updated on {updated} pipes ({missing} skipped -- missing MH match)."
    )


def read_pipes(fc):
    pipes = {}
    fields = ["OID@", PIPE_UPSTREAM_MH_FIELD, PIPE_DOWNSTREAM_MH_FIELD,
              PIPE_BASIN_FIELD, PIPE_LENGTH_SOURCE, "SHAPE@"]
    if PIPE_DIAMETER_FIELD:
        fields.append(PIPE_DIAMETER_FIELD)

    with arcpy.da.SearchCursor(fc, fields) as cur:
        for row in cur:
            oid, up_mh, down_mh, basin, length, shape = row[:6]
            diameter = float(row[6]) if PIPE_DIAMETER_FIELD and len(row) > 6 and row[6] not in (None, "") else None
            pipes[oid] = {
                "up_mh": up_mh, "down_mh": down_mh, "basin": basin,
                "length": length if length else 0.0,
                "shape": shape,
                "diameter": diameter if diameter else 0.0,
                "invert_in": None, "invert_out": None,
                "terrain_stations": None,
            }
    return pipes


def read_points(points_fc):
    # Terrain elevation samples along each pipe, keyed by source pipe OID
    points_by_pipe = defaultdict(list)
    fields = [POINT_ORIG_FID_FIELD, POINT_ELEV_FIELD, "SHAPE@"]
    skipped_null = 0
    with arcpy.da.SearchCursor(points_fc, fields) as cur:
        for orig_fid, elev, shape in cur:
            if elev is None:
                skipped_null += 1
                continue
            points_by_pipe[orig_fid].append({"elev": elev, "shape": shape})
    if skipped_null:
        arcpy.AddWarning(
            f"{skipped_null} point(s) in {POINTS_FC_NAME} had a null "
            f"'{POINT_ELEV_FIELD}' value and were skipped (likely a DEM "
            f"no-data area or a point that fell outside the raster extent)."
        )
    arcpy.AddMessage(
        f"Read terrain samples for {len(points_by_pipe)} pipe(s) from {POINTS_FC_NAME}."
    )
    return points_by_pipe


def attach_terrain_stations(pipes, points_by_pipe, manholes):
    # Each pipe: determine every sample point's fractional distance from the UPSTREAM (0.0) to DOWNSTREAM (1.0), using pipe geometry - NOT assuming the line was digitized directionally
    attached, no_points, no_geom = 0, 0, 0
    for oid, p in pipes.items():
        pts = points_by_pipe.get(oid)
        if not pts:
            no_points += 1
            continue
        line = p.get("shape")
        if line is None or line.length == 0:
            no_geom += 1
            continue

        up_xy = manholes.get(p["up_mh"], {}).get("xy")
        down_xy = manholes.get(p["down_mh"], {}).get("xy")
        starts_at_upstream = True
        if up_xy is not None and down_xy is not None:
            first_pt = line.firstPoint
            d_up = ((first_pt.X - up_xy[0]) ** 2 + (first_pt.Y - up_xy[1]) ** 2) ** 0.5
            d_down = ((first_pt.X - down_xy[0]) ** 2 + (first_pt.Y - down_xy[1]) ** 2) ** 0.5
            starts_at_upstream = d_up <= d_down

        stations = []
        for pt in pts:
            frac_from_start = line.measureOnLine(pt["shape"], True)
            frac_from_upstream = frac_from_start if starts_at_upstream else (1.0 - frac_from_start)
            stations.append((frac_from_upstream, pt["elev"]))
        stations.sort(key=lambda t: t[0])
        p["terrain_stations"] = stations
        attached += 1

    arcpy.AddMessage(
        f"Attached terrain stations to {attached} pipe(s) "
        f"({no_points} with no matching points, {no_geom} with no usable geometry)."
    )


def build_network(pipes):
    # Per basin: index of up_mh -> [successor pipe OIDs], plus the full OID list
    by_basin = defaultdict(list)
    for oid, p in pipes.items():
        by_basin[p["basin"]].append(oid)

    network = {}
    for basin, oids in by_basin.items():
        upstream_index = defaultdict(list)  # up_mh -> [pipe oids starting there]
        for oid in oids:
            upstream_index[pipes[oid]["up_mh"]].append(oid)
        network[basin] = {"oids": oids, "upstream_index": upstream_index}
    return network


def _check_and_adjust_cover(oid, p, min_cover):
    # Compares pipe's own straight-line invert profile against the sampled terrain along its length and shifts down (InvIN/InvOUT) as needed. Returns shift applied (0.0 if none was needed)
    stations = p.get("terrain_stations")
    if not stations:
        return 0.0

    invert_in, invert_out = p["invert_in"], p["invert_out"]
    diameter = p.get("diameter", 0.0)

    worst_shift = 0.0
    worst_detail = None
    for frac, terrain_elev in stations:
        invert_at_pt = invert_in - frac * (invert_in - invert_out)
        crown_at_pt = invert_at_pt + diameter
        max_allowed_crown = terrain_elev - min_cover
        deficit = crown_at_pt - max_allowed_crown
        if deficit > worst_shift:
            worst_shift = deficit
            worst_detail = (frac, terrain_elev, crown_at_pt)

    if worst_shift > 0.001:
        p["invert_in"] = invert_in - worst_shift
        p["invert_out"] = invert_out - worst_shift
        frac, terrain_elev, crown_at_pt = worst_detail
        station_ft = frac * p["length"]
        #arcpy.AddWarning(
        #    f"Pipe OID {oid}: insufficient cover ~{station_ft:.1f} ft from its "
        #    f"upstream MH (terrain {terrain_elev:.2f}, pipe crown was {crown_at_pt:.2f}, "
        #    f"needed <= {terrain_elev - min_cover:.2f} for {min_cover:.2f} ft cover). "
        #    f"Lowered this pipe's InvertIN/InvertOUT by {worst_shift:.2f} ft to clear it "
        #    f"along the full run."
        #)
    return worst_shift


def compute_inverts(pipes, manholes, network):
    cover_adjustments = 0
    for basin, info in network.items():
        oids = info["oids"]
        upstream_index = info["upstream_index"]

        indegree = {oid: 0 for oid in oids}
        for oid in oids:
            for succ_oid in upstream_index.get(pipes[oid]["down_mh"], []):
                indegree[succ_oid] += 1

        incoming_outs = defaultdict(list)
        queue = [oid for oid in oids if indegree[oid] == 0]
        headwaters = list(queue)
        processed = 0

        while queue:
            oid = queue.pop(0)
            p = pipes[oid]
            preds = incoming_outs.get(oid, [])

            if preds:
                p["invert_in"] = min(preds) - (JUNCTION_LOSS if len(preds) > 1 else 0.0)
            else:
                mh = manholes.get(p["up_mh"])
                if mh is None or mh["rim"] is None:
                    arcpy.AddWarning(
                        f"Pipe OID {oid} (basin {basin}): missing rim at upstream MH "
                        f"'{p['up_mh']}' -- cannot seed invert, skipped."
                    )
                    continue
                depth = mh["depth"] if mh["depth"] else DEFAULT_MIN_DEPTH
                p["invert_in"] = mh["rim"] - depth

            drop = max(p["length"] * MIN_SLOPE, MIN_DROP_AT_JUNCTION)
            p["invert_out"] = p["invert_in"] - drop

            # Min cover check against sampled terrain
            # BEFORE invert_out is propagated so any downward shift cascades correctly through the network
            if _check_and_adjust_cover(oid, p, MIN_COVER) > 0:
                cover_adjustments += 1

            processed += 1

            for succ_oid in upstream_index.get(p["down_mh"], []):
                incoming_outs[succ_oid].append(p["invert_out"])
                indegree[succ_oid] -= 1
                if indegree[succ_oid] == 0:
                    queue.append(succ_oid)

        if processed < len(oids):
            stuck = [oid for oid in oids if pipes[oid]["invert_out"] is None]
            arcpy.AddWarning(
                f"Basin {basin}: {len(stuck)} pipe(s) not resolved -- check for a "
                f"cycle or a pipe with no valid upstream/downstream match: {stuck}"
            )

        _check_headwaters_against_basin_max(basin, headwaters, pipes, manholes)

    arcpy.AddMessage(
        f"Minimum-cover check: {cover_adjustments} pipe(s) had InvertIN/InvertOUT "
        f"lowered to maintain {MIN_COVER:.2f} ft cover along their full length."
    )


def _check_headwaters_against_basin_max(basin, headwater_oids, pipes, manholes):
    key = normalize_basin_key(basin)
    max_elev = BASIN_MAX_ELEVATION.get(key)
    if max_elev is None:
        arcpy.AddWarning(f"Basin '{basin}': no entry in BASIN_MAX_ELEVATION -- skipping headwater sanity check.")
        return
    for oid in headwater_oids:
        p = pipes[oid]
        mh = manholes.get(p["up_mh"])
        if mh is None or mh["rim"] is None:
            continue
