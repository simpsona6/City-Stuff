###############################################################################################################################
###############################################################################################################################

# Check if the folder exists, and if not, create it
if not os.path.exists(new_folder):
    os.makedirs(new_folder)
# Define a list of first letters for the geodatabase names
letters = ["Cville_Utilities_Gas_", "Cville_Utilities_Sanitary_", "Cville_Utilities_Storm_", "Cville_Utilities_Water_"]
# Loop through each letter and create a geodatabase with the current date
for letter in letters:
    gdb_name = f"{letter}{current_date}.gdb"
    gdb_path = os.path.join(new_folder, gdb_name)

    if not arcpy.Exists(gdb_path):
        arcpy.CreateFileGDB_management(new_folder, gdb_name)
        print(f"Created geodatabase: {gdb_name}")
    else:
        print(f"Geodatabase {gdb_name} already exists.")

