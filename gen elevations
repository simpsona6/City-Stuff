# MH fields
MH_ID_FIELD = "Asset_ID"
MH_RIM_FIELD = "RimElevation"              # source of truth, from DEM
MH_DEPTH_FIELD = "ManholeDepth"            # derived/adjusted

# Pipe fields
PIPE_UPSTREAM_MH_FIELD = "UpstreamMH"
PIPE_DOWNSTREAM_MH_FIELD = "DownstreamMH"
PIPE_UP_RIM_FIELD = "UpstreamMHRimElevation"
PIPE_DOWN_RIM_FIELD = "DownstreamMHRimElevation"
PIPE_INVERT_IN_FIELD = "InvertINElevation"
PIPE_INVERT_OUT_FIELD = "InvertOUTElevation"
PIPE_FALL_FIELD = "Fall"                   # Fall = InvertIN - InvertOUT; should be > 0 for correct flow direction
PIPE_BASIN_FIELD = "Basin"
PIPE_LENGTH_SOURCE = "SHAPE@LENGTH"       
PIPE_DIAMETER_FIELD = "Diameter"                                                      
                                          
# Points-along-line fields (SanitaryMainLines_GeneratePointsAlongLines for now)
POINT_ORIG_FID_FIELD = "ORIG_FID"          
POINT_ELEV_FIELD = "DEMElev_Points"          

# Design constants (generic defaults)
MIN_SLOPE = 0.004              # minimum slope, ft/ft (0.4%)
MIN_DROP_AT_JUNCTION = 0.10    # minimum fall through a straight-run manhole
JUNCTION_LOSS = 0.05           # additional drop where pipes converge
DEFAULT_MIN_DEPTH = 4.0        # fallback rim-to-invert depth at a headwater MH if ManholeDepth is null/0
MIN_COVER = 3.0                # minimum earth cover (ft) required over the pipe along its whole length
ROUND_DECIMALS = 2

# Warning on computed ManholeDepth,flag manholes whose recomputed depth falls outside range for review
MIN_MANHOLE_DEPTH = 2.0
MAX_MANHOLE_DEPTH = 35.0

# Sanity-check tolerance: how far a basin's topological headwater rim can sit below that basin's known max elevation before flagged as a likely reversed-direction or disconnected-headwater issue.
BASIN_HEADWATER_TOLERANCE = 15.0

# Known max ground elevation per basin
# Basin field values are matched after stripping whitespace and a trailing "-", so "1-", "1", " 1 " all match key "1" below.
BASIN_MAX_ELEVATION = {
