def compute_and_write_manhole_depths(manhole_fc, pipes, manholes):
    # Recompute ManholeDepth from the final invert network and write itback
    lowest_invert_at_mh = {}

    def consider(mh_id, elev):
        if elev is None:
            return
        cur = lowest_invert_at_mh.get(mh_id)
        if cur is None or elev < cur:
            lowest_invert_at_mh[mh_id] = elev

    for p in pipes.values():
        consider(p["up_mh"], p["invert_in"])
        consider(p["down_mh"], p["invert_out"])

    fields = [MH_ID_FIELD, MH_RIM_FIELD, MH_DEPTH_FIELD]
    changed = 0
    with arcpy.da.UpdateCursor(manhole_fc, fields) as cur:
        for row in cur:
            mh_id, rim, old_depth = row
            lowest = lowest_invert_at_mh.get(mh_id)
            if lowest is None or rim is None:
                continue  # manhole not part of the resolved pipe network -- leave depth as-is
            new_depth = round(rim - lowest, ROUND_DECIMALS)
            if new_depth <= 0:
                arcpy.AddWarning(
                    f"Manhole '{mh_id}': computed depth {new_depth} is <= 0 "
                    f"(rim {rim:.2f} vs lowest invert {lowest:.2f}) -- check inputs."
                )
                continue
            if old_depth is None or abs(new_depth - old_depth) > 0.001:
                row[2] = new_depth
                cur.updateRow(row)
                changed += 1
    arcpy.AddMessage(f"ManholeDepth updated on {changed} manholes to match the resolved invert network.")


def validate(pipes, manholes):
    # Reversed/flat-flow check now lives in write_inverts() via the Fall field
    # (Fall = InvertIN - InvertOUT, flagged when <= 0
    pass


def write_inverts(pipe_fc, pipes):
    # Writes InvertIN/InvertOUT and Fall (= InvertIN - InvertOUT). Fall <= 0 is flagged as a likely reversed-flow indicator, since the network is built so InvertIN>InvertOUT
    fields = ["OID@", PIPE_INVERT_IN_FIELD, PIPE_INVERT_OUT_FIELD, PIPE_FALL_FIELD]
    written, reversed_flags = 0, 0
    with arcpy.da.UpdateCursor(pipe_fc, fields) as cur:
        for row in cur:
            oid = row[0]
            p = pipes.get(oid)
            if p and p["invert_out"] is not None:
                invert_in = round(p["invert_in"], ROUND_DECIMALS)
                invert_out = round(p["invert_out"], ROUND_DECIMALS)
                fall = round(invert_in - invert_out, ROUND_DECIMALS)
                row[1] = invert_in
                row[2] = invert_out
                row[3] = fall
                cur.updateRow(row)
                written += 1
                if fall <= 0:
                    reversed_flags += 1
                    arcpy.AddWarning(
                        f"Pipe OID {oid}: Fall = {fall} (<= 0) -- InvertOUT is not below "
                        f"InvertIN, which indicates reversed or flat flow on this pipe."
                    )
    arcpy.AddMessage(
        f"InvertIN/InvertOUT/Fall written on {written} pipes "
        f"({reversed_flags} flagged with Fall <= 0)."
    )


def main():
    manhole_fc = f"{GDB_PATH}\\{MANHOLE_FC_NAME}"
    pipe_fc = f"{GDB_PATH}\\{PIPE_FC_NAME}"
    points_fc = f"{GDB_PATH}\\{POINTS_FC_NAME}"

    arcpy.AddMessage("Reading manholes...")
    manholes = read_manholes(manhole_fc)

    arcpy.AddMessage("Syncing rim elevations onto pipes...")
    update_rim_fields(pipe_fc, manholes)

    arcpy.AddMessage("Reading pipes...")
    pipes = read_pipes(pipe_fc)

    if arcpy.Exists(points_fc):
        arcpy.AddMessage("Reading terrain sample points along pipes...")
        points_by_pipe = read_points(points_fc)
        arcpy.AddMessage("Matching sample points to pipe stations...")
        attach_terrain_stations(pipes, points_by_pipe, manholes)
    else:
        arcpy.AddWarning(
            f"{points_fc} not found -- skipping minimum-cover check. Inverts will "
            f"be computed from slope/junction rules only, with no check against "
            f"terrain dips along the pipe runs."
        )

    arcpy.AddMessage("Building per-basin network...")
    network = build_network(pipes)

    arcpy.AddMessage("Computing inverts (also runs the cover check and basin-max-elevation sanity check)...")
    compute_inverts(pipes, manholes, network)

    arcpy.AddMessage("Recomputing manhole depths from the resolved network...")
    compute_and_write_manhole_depths(manhole_fc, pipes, manholes)

    arcpy.AddMessage("Validating...")
    validate(pipes, manholes)

    arcpy.AddMessage("Writing invert results to pipes...")
    write_inverts(pipe_fc, pipes)

    arcpy.AddMessage("Done.")


if __name__ == "__main__":
    main()
